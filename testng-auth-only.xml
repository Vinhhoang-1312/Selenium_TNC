<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="Authentication Tests Only - Register and Login" verbose="1">
    <listeners>
        <listener class-name="listener.TestListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <!--  REGISTER & LOGIN TESTS -->
    <test name="Authentication Tests - Register and Login Only">
        <groups>
            <run>
                <include name="authentication"/>
                <include name="login"/>
                <!-- <include name="signup"/> -->
            </run>
        </groups>
        <classes>
            <class name="test.authentication.LoginTests"/>
            <!-- <class name="test.authentication.RegisterTests"/> -->
        </classes>
    </test>

</suite>
