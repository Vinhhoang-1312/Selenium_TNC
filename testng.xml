<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="TNC Store Automation Test Suite" verbose="1">
    <listeners>
        <listener class-name="commons.listener.TestListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <!-- 🎯 MAIN TEST SUITE - Using Group-based Structure -->
    <test name="TNC Store Tests - All Features">
        <classes>
            <class name="test.TNCStoreTests"/>
        </classes>
    </test>

</suite>
