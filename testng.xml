<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="TNC Store Automation Test Suite" verbose="1">

    <parameter name="browser" value="chrome"/>

    <test name="All test_case">
        <classes>

            <class name="test.debug.DebugTest">
                <methods>
                    <include name="testDriverSetup"/>
                </methods>
            </class>

            <!--class test cho product_detail-->
            <class name="test.productdetail.ProductDetailTest">
                <methods><include name="testAddToCart"/>
                    <include name="testScrollToBottomAndViewProductDetail"/>
                </methods>
            </class>

            <!--class test cho search-->
            <class name="test.search.SearchTest">
                <methods>
                    <include name="testSearchFunctionality"/>
                    <include name="testSearchResults"/>
                    <include name="testSearchForRTX2050"/>
                    <include name="testSearchForRTX2050Repeat"/>
                    <include name="testSearchPerformCorrect"/>
                    <include name="testSearchReloadPage"/>
                    <include name="testSearchWithNoKeyword"/>
                </methods>
            </class>


            <class name="test.simple.SimpleDriverTest">
                <methods><include name="testDriverWorks"/>
                </methods>
            </class>

            <!-- REGISTER VÀ LOGIN (FIXED) -->
            <class name="test.authentication.RegisterTests"/>
            <class name="test.authentication.LoginTests"/>

        </classes>
    </test>
</suite>