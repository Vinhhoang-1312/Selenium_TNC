<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TNC Store Test Suite" parallel="none" thread-count="1">
    <parameter name="browser" value="chrome"/>

    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="tests"/>
        </packages>
    </test>
</suite>

