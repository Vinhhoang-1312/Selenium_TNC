<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="TNC Store Automation Test Suite" verbose="1">
    <listeners>
        <listener class-name="listener.TestListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <!-- 🎯 AUTHENTICATION MODULE - ĐANG ACTIVE -->
    <test name="Authentication Tests">
        <classes>
            <class name="modules.authentication.AuthenticationTest">
                <!-- 🔧 Có thể chỉ chạy test method cụ thể -->
                <methods>
                    <include name="testRegisterWithValidData"/>
                    <include name="testRegisterWithExistingEmail"/>
                    <include name="testLoginWithValidCredentials"/>
                    <!-- Thêm các test khác nếu cần thiết -->
                </methods>
            </class>
        </classes>
    </test>

    <!-- 👤 USER PROFILE MODULE - Chưa implement -->
    <test name="User Profile Tests">
        <classes>
            <class name="modules.userprofile.UserProfileTest"/>
        </classes>
    </test>
</suite>
