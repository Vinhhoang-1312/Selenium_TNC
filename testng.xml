<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TNC Store Test Suite" parallel="classes" thread-count="4">
    <parameter name="browser" value="chrome"/>

    <!-- Register Allure TestNG listener first so Allure lifecycle is initialized before custom listeners -->
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <groups>
        <define name="authentication"/>
        <define name="smoke"/>
        <define name="login"/>
        <define name="negative"/>
    </groups>

    <test name="Full Test Suite">
        <packages>
            <package name="tests"/>
        </packages>
    </test>
</suite>
