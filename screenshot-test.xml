<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Screenshot Test Suite" parallel="false" thread-count="1">
    <parameter name="browser" value="chrome"/>

    <listeners>
        <listener class-name="listeners.BaseListener"/>
    </listeners>

    <test name="Test Screenshot Capture on Failure">
        <classes>
            <class name="tests.LoginTests">
                <methods>
                    <include name="testScreenshotCapture_IntentionalFail"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
