<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Authentication Test Suite">

    <listeners>
        <listener class-name="listener.TestListener"/>
    </listeners>

    <test verbose="2" preserve-order="true" name="Authentication Tests">
        <classes>
            <!-- Login test cases -->
            <class name="test.login.LoginWithValidCredentialsTest"/>
            <class name="test.login.LoginWithNonExistentAccountTest"/>
            <class name="test.login.LoginWithInvalidEmailTest"/>
            <class name="test.login.LoginWithEmptyPasswordTest"/>
            <class name="test.login.LoginWithEmptyEmailTest"/>
            <class name="test.login.LoginWithBothFieldsEmptyTest"/>

            <!-- Register test cases -->
            <class name="test.register.RegisterWithValidDataTest"/>
            <class name="test.register.RegisterWithInvalidEmailTest"/>
            <class name="test.register.RegisterWithWeakPasswordTest"/>

            <!-- User profile test cases -->
            <class name="test.userprofile.UpdateFullnameTest"/>
            <class name="test.userprofile.UpdatePhoneSuccessTest"/>
        </classes>
    </test>
</suite>
