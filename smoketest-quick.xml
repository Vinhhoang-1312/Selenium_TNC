<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Test - Quick Check" parallel="false" thread-count="1">
    <parameter name="browser" value="chrome"/>

    <!-- Test Login -->
    <test name="Login Smoke Test">
        <classes>
            <class name="tests.LoginTests">
                <methods>
                    <include name="testLoginWithValidCredentials"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Test Register -->
    <test name="Register Smoke Test">
        <classes>
            <class name="tests.RegisterTests">
                <methods>
                    <include name="testRegisterWithValidData"/>
                </methods>
            </class>
        </classes>
    </test>
    <!-- Test UserProfile -->
    <test name="Search Smoke Test">
        <classes>
            <class name="tests.UserProfileTests">
                <methods>
                    <include name="testUpdatePhoneSuccess"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Test Search -->
    <test name="Search Smoke Test">
        <classes>
            <class name="tests.SearchTests">
                <methods>
                    <include name="testSearchWithValidKeyword"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Test Product Detail -->
    <test name="Product Detail Smoke Test">
        <classes>
            <class name="tests.ProductDetailTests">
                <methods>
                    <include name="testMinusQuantityShowsAlert"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
