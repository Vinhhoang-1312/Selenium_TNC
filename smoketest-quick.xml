<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Test - Quick Check (15 Tests)" parallel="false" thread-count="1">
    <parameter name="browser" value="chrome"/>

    <!-- GROUP 1: Login-Register-UserProfile Tests (5 cases) -->
    <test name="Login Test">
        <classes>
            <class name="tests.LoginTests">
                <methods>
                    <include name="testLoginWithValidCredentials"/>
                    <include name="testLoginWithInvalidEmail"/>

                </methods>
            </class>
        </classes>
    </test>

    <test name="Register Test">
        <classes>
            <class name="tests.RegisterTests">
                <methods>
                    <include name="testRegisterWithValidData"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="User Profile Tests">
        <classes>
            <class name="tests.UserProfileTests">
                <methods>
                    <include name="testUpdatePhoneSuccess"/>
                    <include name="testUpdateFullname"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- GROUP 2: Cart Tests (5 cases) -->
    <test name="Cart Tests">
        <classes>
            <class name="tests.CartTests">
                <methods>
                    <include name="testAddSingleProductToCart"/>
                    <include name="testIncreaseItemQuantity"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- GROUP 3: Product Detail Tests (5 cases) -->
    <test name="Product Detail Tests">
        <classes>
            <class name="tests.ProductDetailTests">
                <methods>
                    <include name="testVerifyProductDetailsDisplayed"/>
                    <include name="testAddProductToCartShowsNotification"/>

                </methods>
            </class>
        </classes>
    </test>
</suite>
