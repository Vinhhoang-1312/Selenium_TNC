<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="TNC Store Test Suite - Divided by Functions" verbose="1">
    <listeners>
        <!-- Corrected listener package -->
        <listener class-name="commons.listener.TestListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <!-- 🔥 SMOKE TESTS - Critical functionality -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="test.authentication.LoginTests"/>
            <class name="test.authentication.RegisterTests"/>
            <class name="test.userprofile.ProfileViewTests"/>
        </classes>
    </test>

    <!-- 🧪 AUTHENTICATION TESTS - Login -->
    <test name="Authentication Tests - Login">
        <groups>
            <run>
                <include name="login"/>
            </run>
        </groups>
        <classes>
            <class name="test.authentication.LoginTests"/>
        </classes>
    </test>

    <!-- 🧪 AUTHENTICATION TESTS - Register -->
    <test name="Authentication Tests - Register">
        <groups>
            <run>
                <include name="signup"/>
            </run>
        </groups>
        <classes>
            <class name="test.authentication.RegisterTests"/>
        </classes>
    </test>

    <!-- 🧪 AUTHENTICATION TESTS - Forgot Password -->
    <test name="Authentication Tests - Forgot Password">
        <groups>
            <run>
                <include name="forgot-password"/>
            </run>
        </groups>
        <classes>
            <class name="test.authentication.ForgotPasswordTests"/>
        </classes>
    </test>

    <!-- 👤 USER PROFILE TESTS - View -->
    <test name="User Profile Tests - View">
        <groups>
            <run>
                <include name="profile-view"/>
            </run>
        </groups>
        <classes>
            <class name="test.userprofile.ProfileViewTests"/>
        </classes>
    </test>

    <!-- 👤 USER PROFILE TESTS - Update -->
    <test name="User Profile Tests - Update">
        <groups>
            <run>
                <include name="profile-update"/>
            </run>
        </groups>
        <classes>
            <class name="test.userprofile.ProfileUpdateTests"/>
        </classes>
    </test>

    <!-- 👤 USER PROFILE TESTS - Password Change -->
    <test name="User Profile Tests - Password Change">
        <groups>
            <run>
                <include name="password-change"/>
            </run>
        </groups>
        <classes>
            <class name="test.userprofile.PasswordChangeTests"/>
        </classes>
    </test>

    <!-- 🔄 REGRESSION TESTS - Authentication -->
    <test name="Regression Tests - All Authentication">
        <groups>
            <run>
                <include name="authentication"/>
            </run>
        </groups>
        <classes>
            <class name="test.authentication.LoginTests"/>
            <class name="test.authentication.RegisterTests"/>
            <class name="test.authentication.ForgotPasswordTests"/>
        </classes>
    </test>

    <!-- 🔄 REGRESSION TESTS - User Profile -->
    <test name="Regression Tests - All User Profile">
        <groups>
            <run>
                <include name="userprofile"/>
            </run>
        </groups>
        <classes>
            <class name="test.userprofile.ProfileViewTests"/>
            <class name="test.userprofile.ProfileUpdateTests"/>
            <class name="test.userprofile.PasswordChangeTests"/>
        </classes>
    </test>

    <!-- 🚀 FULL SUITE - All tests by functions -->
    <test name="Full Test Suite - By Functions">
        <classes>
            <class name="test.authentication.LoginTests"/>
            <class name="test.authentication.RegisterTests"/>
            <class name="test.authentication.ForgotPasswordTests"/>
            <class name="test.userprofile.ProfileViewTests"/>
            <class name="test.userprofile.ProfileUpdateTests"/>
            <class name="test.userprofile.PasswordChangeTests"/>
        </classes>
    </test>

</suite>
