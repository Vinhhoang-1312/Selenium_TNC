<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="TNC Store Test Suite - Group Based" verbose="1">
    <listeners>
        <listener class-name="listener.TestListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <!-- 🔥 SMOKE TESTS - Critical functionality -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.TNCStoreTests"/>
        </classes>
    </test>

    <!-- 🧪 AUTHENTICATION FEATURE TESTS -->
    <test name="Authentication Feature Tests">
        <groups>
            <run>
                <include name="authentication"/>
            </run>
        </groups>
        <classes>
            <class name="tests.TNCStoreTests"/>
        </classes>
    </test>

    <!-- 👤 USER PROFILE FEATURE TESTS -->
    <test name="User Profile Feature Tests">
        <groups>
            <run>
                <include name="userprofile"/>
            </run>
        </groups>
        <classes>
            <class name="tests.TNCStoreTests"/>
        </classes>
    </test>

    <!-- 📝 SIGNUP SPECIFIC TESTS -->
    <test name="Signup Tests">
        <groups>
            <run>
                <include name="signup"/>
            </run>
        </groups>
        <classes>
            <class name="tests.TNCStoreTests"/>
        </classes>
    </test>

    <!-- 🔐 LOGIN SPECIFIC TESTS -->
    <test name="Login Tests">
        <groups>
            <run>
                <include name="login"/>
            </run>
        </groups>
        <classes>
            <class name="tests.TNCStoreTests"/>
        </classes>
    </test>

    <!-- 🔒 PASSWORD RELATED TESTS -->
    <test name="Password Tests">
        <groups>
            <run>
                <include name="forgot-password"/>
                <include name="password-change"/>
            </run>
        </groups>
        <classes>
            <class name="tests.TNCStoreTests"/>
        </classes>
    </test>

    <!-- 📊 PROFILE MANAGEMENT TESTS -->
    <test name="Profile Management Tests">
        <groups>
            <run>
                <include name="profile-view"/>
                <include name="profile-update"/>
            </run>
        </groups>
        <classes>
            <class name="tests.TNCStoreTests"/>
        </classes>
    </test>

    <!-- 🔄 REGRESSION TESTS - All comprehensive tests -->
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="tests.TNCStoreTests"/>
        </classes>
    </test>

    <!-- 🚀 FULL SUITE - All tests -->
    <test name="Full Test Suite">
        <classes>
            <class name="tests.TNCStoreTests"/>
        </classes>
    </test>

</suite>
